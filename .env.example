# Copie este arquivo para .env.local em desenvolvimento.
# Na Vercel, cadastre os valores em Project Settings > Environment Variables.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use SOMENTE a chave pública anon (legada) OU a publishable. Nunca service_role.
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon
# Opcional; se preenchida, tem precedência sobre VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=
